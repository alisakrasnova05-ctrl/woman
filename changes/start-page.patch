+:root{--blue:#2563eb;--ink:#182235;--muted:#667085;--line:#e5e9f1;--bg:#f6f8fb}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px Inter,Arial,sans-serif}header{height:68px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100% - 1120px)/2))}.brand{font-size:21px;font-weight:700;color:var(--blue)}.brand span{color:var(--ink);margin-left:6px}.tagline,.muted{color:var(--muted)}main{max-width:1120px;margin:0 auto;padding:50px 24px}.create-panel{background:#fff;border:1px solid var(--line);padding:28px;display:grid;grid-template-columns:1fr 1.4fr;gap:32px;align-items:end}.eyebrow{font-size:11px;letter-spacing:.12em;color:var(--blue);font-weight:700;margin:0 0 8px}h1{font-size:30px;margin:0 0 8px}h2{font-size:24px;margin:0}.create-panel form{display:grid;grid-template-columns:1fr 1.5fr auto;gap:12px;align-items:end}.create-panel label{font-size:11px;font-weight:700;letter-spacing:.08em}.selects{display:flex;gap:8px;margin-top:7px}.selects select,.destination input{width:100%;height:44px;border:1px solid #d4dbe7;background:#fff;padding:0 12px;font:inherit;font-size:14px;border-radius:6px}.destination input{margin-top:7px}.add-btn{height:44px;background:var(--blue);color:#fff;border:0;border-radius:6px;padding:0 20px;font-weight:700;cursor:pointer}.error{color:#b42318;font-size:12px;grid-column:1/-1}.history{margin-top:44px}.history-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.count{color:var(--muted);font-size:13px}.trip-list{display:grid;gap:12px}.trip-card{background:#fff;border:1px solid var(--line);display:grid;grid-template-columns:180px 1fr auto;min-height:126px;cursor:pointer}.trip-card:hover{border-color:var(--blue)}.cover{background:#dbeafe;color:#1d4ed8;display:flex;align-items:center;justify-content:center;font-size:34px}.trip-info{padding:20px}.trip-info h3{margin:0 0 12px;font-size:22px}.trip-meta{color:var(--muted);font-size:13px}.stats{display:flex;gap:18px;margin-top:15px;color:var(--muted);font-size:12px}.trip-arrow{padding:22px;color:var(--blue);font-size:25px;display:flex;align-items:center}.empty{border:1px dashed #cbd5e1;background:#fff;padding:55px;text-align:center;color:var(--muted)}@media(max-width:760px){header{padding:0 18px}.tagline{display:none}main{padding:28px 16px}.create-panel{display:block;padding:20px}.create-panel form{display:flex;flex-direction:column;align-items:stretch;margin-top:22px}.trip-card{grid-template-columns:88px 1fr}.trip-arrow{display:none}.cover{font-size:25px}}
