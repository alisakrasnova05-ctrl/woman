PORT=3000
# Optional: Mapbox token (not required; demo uses free OpenStreetMap tiles)
MAPBOX_TOKEN=your_mapbox_public_token_here

# Server-side only. Never place the real key in public/ or commit .env.
LLM_API_KEY=
# Spirit docs: https://docs.pages.t-education.com/docs/docs/ai/llm-proxy/usage
LLM_BASE_URL=https://llm-proxy.spirit.t-education.com/
# Choose a model allowed by your proxy account.
LLM_MODEL=openai/gpt-6-luna
